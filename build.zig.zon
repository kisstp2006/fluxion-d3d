// SPDX-License-Identifier: BSL-1.0

.{
    .name = .fluxion_d3d,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x7e36c43a10b3f6b9,
    .dependencies = .{
        // The library's one dependency.
        .fluxion_dyn = .{
            .url = "git+https://github.com/kisstp2006/fluxion-dyn#78c8c2a2ddcad8e90d3b45c0f80023f0b479f26b",
            .hash = "fluxion_dyn-0.1.0-5Dy8EU9PAQAp7cuNi6RU8eu0pgcFXWUbrBq69b7idVnA",
        },

        // The window the examples put a swap chain in. Lazy: fetched only
        // when the examples are built, which is when this is the root package
        // or `-Dexamples` is given. A program that depends on `fluxion_d3d`
        // never downloads it, and the module itself does not import it - the
        // library stops at a device, and a window is what a program brings.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#9f1074bad5a0065d9dec480d02ac04703933cf1c",
            .hash = "fluxion_platform-0.1.0-WsOjUQfIDwCfGQbLE_BLrLcPicPcGadwyqYXABp9zB7r",
            .lazy = true,
        },
        // And what `--capture` saves a frame with. Lazy for the same reason.
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#79463ef201f11e15ada014467c0ad1d58b2a882d",
            .hash = "fluxion_image-0.1.0-fyJkdS7vAAB1p43VSutvpxQB32hIcvJb3fGSZbo_qeha",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
